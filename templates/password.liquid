<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <div class="wrap empty" style="min-height:100svh;display:grid;place-content:center">
    <img src="{{ 'kalo-mark.webp' | asset_url }}" alt="" width="96" height="96" style="margin:0 auto 24px;border-radius:50%">
    <h1>{{ shop.name }} <em>opens soon</em></h1>
    <p class="meta" style="margin:18px 0 28px">{{ shop.password_message | default: 'Christmas gifts, packed by hand in Chennai.' }}</p>
    {%- form 'storefront_password' -%}
      <div class="field" style="max-width:340px;margin-inline:auto">
        <label for="Password">Enter store password</label>
        <input type="password" name="password" id="Password" style="width:100%;border:0;border-bottom:1px solid var(--hair-2);background:transparent;padding:10px 2px;font-size:18px">
      </div>
      {%- if form.errors -%}<p class="meta">Incorrect password.</p>{%- endif -%}
      <button class="btn gold" type="submit">Enter</button>
    {%- endform -%}
  </div>
</body>
</html>
